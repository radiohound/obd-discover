# Copy to keystore.properties and fill in. That file is git-ignored.
#
# The keystore itself is deliberately OUTSIDE the repository. It cannot be
# regenerated: lose it and existing installs can never be updated again, because
# Android refuses an update signed by a different key.
storeFile=/Users/YOU/obddiscover-release.jks
storePassword=
keyAlias=obddiscover
keyPassword=
